@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .simple-carousel{
        height:480px;                 /* alto del slider */
        border-radius:24px;           /* esquinas redondeadas */
        overflow:hidden;              /* respeta el radio */
        box-shadow:0 10px 25px rgba(0,0,0,.15); /* sombra */
    }
    .simple-carousel .carousel-item img{
        height:100%;
        object-fit:cover;             /* rellena sin deformar */
    }
</style>

<div class="container py-5">
    <!-- ===== Slider ===== -->
    <div id="simpleCarousel" class="carousel slide simple-carousel" data-bs-ride="carousel">
        <div class="carousel-inner">
            <div class="carousel-item active">
                <img src="https://picsum.photos/id/1015/1200/800" class="w-100" alt="Slide 1">
            </div>
            <div class="carousel-item">
                <img src="https://picsum.photos/id/1025/1200/800" class="w-100" alt="Slide 2">
            </div>
            <div class="carousel-item">
                <img src="https://picsum.photos/id/1043/1200/800" class="w-100" alt="Slide 3">
            </div>
        </div>

        <!-- Flechas -->
        <button class="carousel-control-prev" type="button" data-bs-target="#simpleCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#simpleCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
    <!-- ===== /Slider ===== -->
</div>

<!-- JS de Bootstrap -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
